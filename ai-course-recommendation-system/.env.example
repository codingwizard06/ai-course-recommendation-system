# ============================================================
#  AI Course Recommendation System — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to GitHub!
# ============================================================

# ---- Backend Server ----------------------------------------
PORT=5000
NODE_ENV=development

# ---- JWT Authentication (change this to a long random string!) ----
JWT_SECRET=replace_with_a_long_random_secret_key_min_32_chars

# ---- MongoDB (optional — app works without it via JSON fallback) ----
MONGODB_URI=mongodb://localhost:27017/ai_course_recommender

# ---- Python ML Service URL --------------------------------
ML_SERVICE_URL=http://127.0.0.1:5001

# ---- AI Assistant API Keys (optional — assistant works without these) ----
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
